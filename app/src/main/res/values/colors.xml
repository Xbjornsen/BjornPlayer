<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Semantic tokens (LIGHT). The same names are redefined in
         values-night/colors.xml so the app follows the system theme.
         ============================================================ -->
    <color name="bg_primary">#F7F5F2</color>        <!-- page background -->
    <color name="surface">#FFFFFF</color>           <!-- cards, sheets, nav -->
    <color name="surface_variant">#F0EBE4</color>   <!-- search field, chips, mini-bar art -->
    <color name="text_primary">#1A1714</color>
    <color name="text_secondary">#7C7068</color>
    <color name="divider">#ECE6DF</color>

    <!-- Warm orange. Slightly deeper in light mode so it stays legible on white;
         values-night uses the brighter #FF7A45. -->
    <color name="accent">#E85D2A</color>
    <color name="on_accent">#FFFFFF</color>         <!-- icon/text drawn on top of accent fills -->
    <color name="accent_muted">#22E85D2A</color>    <!-- low-alpha accent for icon circles / current row -->

    <!-- System required -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
